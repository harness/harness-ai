{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": "./scripts/check-templates.mjs",
        "matcher": "MCP:harness_create",
        "timeout": 20
      },
      {
        "command": "./scripts/check-vibe-write.mjs",
        "matcher": "MCP:deploy_vibe_app|MCP:retry_vibe_deployment|MCP:cancel_vibe_deployment",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./scripts/validate-policies.mjs",
        "matcher": "MCP:harness_create|MCP:harness_update",
        "timeout": 20
      }
    ]
  }
}
